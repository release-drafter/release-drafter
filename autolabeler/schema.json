{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_extends": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "\\S"
            },
            "strategy": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "enum": ["override", "append", "prepend"]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["from"],
          "additionalProperties": false
        }
      ]
    },
    "autolabeler": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "labels": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Labels to add when this rule matches, in configuration order."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Backward-compatible single label. Prefer labels for new rules."
              },
              "stop-on-match": {
                "default": false,
                "type": "boolean"
              },
              "files": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "branch": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "title": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "body": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["labels"]
          },
          {
            "type": "object",
            "properties": {
              "labels": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Labels to add when this rule matches, in configuration order."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Backward-compatible single label. Prefer labels for new rules."
              },
              "stop-on-match": {
                "default": false,
                "type": "boolean"
              },
              "files": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "branch": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "title": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "body": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["label"]
          }
        ]
      }
    },
    "autolabeler-fallback-label": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["autolabeler"],
  "title": "JSON schema for Release Drafter's autolabeler action config."
}
