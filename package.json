{
  "name": "@release-drafter/root",
  "description": "Private workspace coordinator for Release Drafter.",
  "version": "7.7.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/release-drafter/release-drafter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-drafter/release-drafter.git"
  },
  "bugs": {
    "url": "https://github.com/release-drafter/release-drafter/issues"
  },
  "keywords": [
    "actions",
    "release",
    "release-notes",
    "release-automation"
  ],
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "npm": ">=12.0.1"
  },
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./src/tests/*"
  },
  "scripts": {
    "build": "npm run build:actions && npm run build:workspaces",
    "build:actions": "vite build",
    "build:workspaces": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "node src/scripts/coverage-summary.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:docs": "prettier --write \"**/*.md\"",
    "format:docs:check": "prettier --check \"**/*.md\"",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "generate:graphql": "graphql-codegen -c src/scripts/graphql.codegen-config.ts -v",
    "generate:schemas": "npm run build:workspaces && node src/scripts/json-schema.ts",
    "check:dependencies": "knip --config knip.jsonc --no-progress",
    "check:boundaries": "dependency-cruiser --config .dependency-cruiser.mjs packages",
    "check:packages": "node src/scripts/guard-packages.ts",
    "check:package-boundaries": "node src/scripts/guard-boundaries.ts",
    "check:workspaces": "npm run check:dependencies && npm run check:boundaries && npm run check:packages && npm run check:package-boundaries",
    "ci": "npm run lint:fix && npm run format:docs && npm run typecheck && npm run test:run && npm run generate:schemas && npm run build:actions && npm run check:workspaces",
    "check:clean": "node src/scripts/check-clean.ts",
    "preversion": "npm run ci && npm run check:clean",
    "version": "node src/scripts/sync-workspace-versions.ts && npm install --package-lock-only --ignore-scripts && git add package.json package-lock.json packages/*/package.json",
    "postversion": "git push && git push origin v$npm_package_version"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@release-drafter/autolabeler": "*",
    "@release-drafter/core": "*",
    "@release-drafter/github-adapter": "*",
    "compare-versions": "^6.1.1",
    "escape-string-regexp": "^5.0.0",
    "graphql": "^17.0.2",
    "regex-parser": "^2.3.1",
    "verkit": "0.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@swc/core": "1.15.46",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "18.1.0",
    "knip": "6.29.0",
    "nock": "^14.0.16",
    "prettier": "^3.9.6",
    "rolldown-plugin-dts": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*"
  ]
}
