{
  "name": "@release-drafter/root",
  "description": "Private workspace coordinator for Release Drafter.",
  "version": "7.10.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/release-drafter/release-drafter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-drafter/release-drafter.git"
  },
  "bugs": {
    "url": "https://github.com/release-drafter/release-drafter/issues"
  },
  "keywords": [
    "actions",
    "release",
    "release-notes",
    "release-automation"
  ],
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "npm": ">=12.0.1"
  },
  "imports": {
    "#gh-actions/*": "./packages/gh-actions/src/*",
    "#src/*": "./src/*",
    "#tests/*": "./src/tests/*"
  },
  "scripts": {
    "test": "vp test",
    "test:conformance:gitea": "FORGE_CONFORMANCE_TARGET=gitea vp test run --config vitest.forge.config.ts",
    "test:conformance:forgejo": "FORGE_CONFORMANCE_TARGET=forgejo vp test run --config vitest.forge.config.ts",
    "test:conformance:gitea-forgejo": "vp test run --config vitest.forge.config.ts",
    "test:conformance:gitlab": "vp test run --config vitest.gitlab.config.ts",
    "coverage": "node src/scripts/coverage-summary.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "check:package-readiness": "node src/scripts/check-package-readiness.ts",
    "ci": "vp run generate:action-metadata && vp check && vp run test:run && vp run generate:schemas && vp run build:actions && vp test run --config vitest.artifacts.config.ts && vp run check:workspaces",
    "check:clean": "node src/scripts/check-clean.ts",
    "version": "node src/scripts/sync-workspace-versions.ts && npm install --package-lock-only --ignore-scripts && git add package.json package-lock.json packages/*/package.json",
    "prepare": "vp config",
    "fix": "vp check --fix"
  },
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@release-drafter/autolabeler": "*",
    "@release-drafter/core": "*",
    "@release-drafter/gh-actions": "*",
    "@release-drafter/github-adapter": "*",
    "graphql": "^17.0.2",
    "release-drafter": "*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "knip": "6.39.0",
    "nock": "^14.0.17",
    "testcontainers": "12.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@12.0.1"
}
