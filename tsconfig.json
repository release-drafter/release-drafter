{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "types": ["node", "vite/client"],
    "newLine": "lf",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "pretty": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "#src/*": ["./src/*"],
      "#gh-actions/*": ["./packages/gh-actions/src/*"],
      "@release-drafter/autolabeler": ["./packages/autolabeler/src/index.ts"],
      "@release-drafter/cli": ["./packages/cli/src/index.ts"],
      "@release-drafter/core": ["./packages/core/src/index.ts"],
      "@release-drafter/github-adapter": [
        "./packages/github-adapter/src/index.ts"
      ],
      "@release-drafter/rest-adapter": ["./packages/rest-adapter/src/index.ts"],
      "@release-drafter/gitea-adapter": [
        "./packages/gitea-adapter/src/index.ts"
      ],
      "@release-drafter/forgejo-adapter": [
        "./packages/forgejo-adapter/src/index.ts"
      ],
      "@release-drafter/gitlab-adapter": [
        "./packages/gitlab-adapter/src/index.ts"
      ],
      "@release-drafter/gh-actions": ["./packages/gh-actions/src/index.ts"],
      "@release-drafter/gh-actions/drafter": [
        "./packages/gh-actions/src/drafter/index.ts"
      ],
      "@release-drafter/gh-actions/autolabeler": [
        "./packages/gh-actions/src/autolabeler/index.ts"
      ],
      "@release-drafter/gh-actions/check-pr-title": [
        "./packages/gh-actions/src/check-pr-title/index.ts"
      ],
      "@release-drafter/gh-actions/config": [
        "./packages/gh-actions/src/config.ts"
      ]
    },
    "skipLibCheck": true
  },
  "exclude": ["coverage", "dist", "node_modules", "**/*.generated.ts"],
  "include": ["src", "packages/*/src"]
}
