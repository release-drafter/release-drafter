{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "include": ["dependencies", "devDependencies", "unlisted"],
  "vite": false,
  "workspaces": {
    ".": {
      "entry": ["src/scripts/*.ts", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,mts,cts,js,mjs,cjs}"],
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": false,
    },
    "packages/gh-actions": {
      "entry": [
        "src/index.ts",
        "src/config.ts",
        "src/drafter/index.ts",
        "src/drafter/run.ts",
        "src/autolabeler/index.ts",
        "src/autolabeler/run.ts",
        "src/check-pr-title/index.ts",
        "src/check-pr-title/run.ts",
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": false,
    },
    "packages/release-drafter": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@octokit/core",
        "@octokit/plugin-paginate-graphql",
        "@octokit/plugin-paginate-rest",
        "@octokit/plugin-rest-endpoint-methods",
        "@octokit/plugin-retry",
        "undici",
      ],
      "vite": false,
    },
  },
}
