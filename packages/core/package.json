{
  "name": "@release-drafter/core",
  "version": "7.7.0",
  "description": "Forge-neutral release drafting and orchestration.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "release-drafter-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "release-drafter-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run --config ../../vite.workspace.config.ts"
  },
  "dependencies": {
    "compare-versions": "^6.1.1",
    "conventional-commits-parser": "^7.1.2",
    "escape-string-regexp": "^5.0.0",
    "minimatch": "^10.2.6",
    "verkit": "0.5.0",
    "zod": "^4.6.5"
  },
  "license": "ISC",
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "private": true
}
