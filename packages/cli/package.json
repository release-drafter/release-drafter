{
  "name": "@release-drafter/cli",
  "version": "7.10.0",
  "description": "Private command-line runtime for Release Drafter.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "release-drafter-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "release-drafter-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test:run": "vp test run --config ../../vite.workspace.config.ts"
  },
  "dependencies": {
    "@release-drafter/core": "*",
    "@release-drafter/forgejo-adapter": "*",
    "@release-drafter/gitea-adapter": "*",
    "@release-drafter/gitlab-adapter": "*",
    "@release-drafter/github-adapter": "*",
    "@release-drafter/rest-adapter": "*"
  },
  "devDependencies": {
    "vite-plus": "1.1.0"
  },
  "license": "ISC",
  "private": true
}
