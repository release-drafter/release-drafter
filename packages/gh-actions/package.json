{
  "name": "@release-drafter/gh-actions",
  "version": "7.7.0",
  "description": "Private runtime composition for Release Drafter GitHub Actions.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drafter": {
      "types": "./dist/drafter/index.d.ts",
      "import": "./dist/drafter/index.js"
    },
    "./autolabeler": {
      "types": "./dist/autolabeler/index.d.ts",
      "import": "./dist/autolabeler/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts && tsc --noCheck -p tsconfig.declarations.json",
    "tsc:check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@release-drafter/autolabeler": "*",
    "@release-drafter/core": "*",
    "@release-drafter/github-adapter": "*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "private": true
}
