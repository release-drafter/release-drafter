{
  "name": "release-drafter",
  "version": "7.7.0",
  "description": "Programmatic API and command-line interface for Release Drafter.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "release-drafter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts && tsc --emitDeclarationOnly --noEmit false --declarationMap false --noCheck --outDir dist -p tsconfig.declarations.json",
    "tsc:check": "tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run --config ../../vite.workspace.config.ts"
  },
  "dependencies": {
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-graphql": "^6.0.0",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "@octokit/plugin-retry": "^8.1.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@release-drafter/cli": "*",
    "@release-drafter/core": "*"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
