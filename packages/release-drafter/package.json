{
  "name": "release-drafter",
  "version": "7.7.0",
  "description": "Forge-neutral programmatic API for Release Drafter.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "release-drafter-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "release-drafter-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run --config ../../vite.workspace.config.ts"
  },
  "devDependencies": {
    "@release-drafter/core": "*",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
