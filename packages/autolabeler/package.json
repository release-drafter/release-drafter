{
  "name": "@release-drafter/autolabeler",
  "version": "7.7.0",
  "description": "Runtime-neutral configuration and matching for Release Drafter's autolabeler.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "release-drafter-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "release-drafter-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run --config ../../vite.workspace.config.ts"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "ignore": "^7.0.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
