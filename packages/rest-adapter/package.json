{
  "name": "@release-drafter/rest-adapter",
  "version": "7.7.0",
  "description": "Bounded GitHub-compatible REST protocol mechanics for Release Drafter forge adapters.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "release-drafter-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "release-drafter-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.workspace.config.ts",
    "test:run": "vitest run --config ../../vite.workspace.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@release-drafter/core": "*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
